=== desugar ===

rule "etl-stage":
  match: Stage: `{command}` to {purpose}
  rewrite: `{command}` -- {purpose}.

rule "etl-check":
  match: Check: {condition}
  rewrite: make sure {condition}.

rule "etl-note":
  match: Note: {message}
  lowers to: emit etl.note with message = {message}.

rule "etl-emit":
  match: Emit: {message}
  lowers to: emit etl.report with message = {message}.

