  "meridian_skill" : {
    "description" : "Hold a downstream dataset until its upstream dependency actually signals completion, then run the extraction and the quality checks side by side instead of one after the other. This is the DAG-awareness layer that keeps a downstream stage from starting on data its upstream hasn't finished producing.",
    "name" : "dag orchestrate",
    "outline" : [
      {
        "kind" : "applicability",
