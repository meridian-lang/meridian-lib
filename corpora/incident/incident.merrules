=== desugar ===

rule "incident-runbook":
  match: Runbook: `{command}` to {purpose}
  rewrite: `{command}` -- {purpose}.

rule "incident-check":
  match: Check: {condition}
  rewrite: make sure {condition}.

rule "incident-note":
  match: Note: {message}
  lowers to: emit incident.note with message = {message}.

rule "incident-post":
  match: Post: {message}
  lowers to: emit incident.report with message = {message}.

