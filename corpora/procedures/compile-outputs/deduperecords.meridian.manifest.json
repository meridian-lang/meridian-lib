        "heading" : "Procedure — steps",
        "line" : 17,
        "lines" : [
          "fetch duplicate records",
          "Check: any duplicate records",
          "for each record whose status is \"duplicate\":",
          "compute a checksum for the record",
          "if the record is duplicate and either the record is stale or the record is drifted,",
          "mark the record canonical",
          "purge the record,",
          "otherwise,",
          "Note: \"record retained pending manual review\"",
          "Emit: \"duplicate record pass complete\""
        ],
        "role" : "procedure"
      },
      {
        "executes" : true,
