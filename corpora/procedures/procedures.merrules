=== desugar ===

rule "procedure-sql-command":
  match: SQL: `{command}` to {purpose}
  rewrite: `{command}` -- {purpose}.

rule "procedure-check":
  match: Check: {condition}
  rewrite: make sure {condition}.

rule "procedure-note":
  match: Note: {message}
  lowers to: emit procedure.note with message = {message}.

rule "procedure-emit":
  match: Emit: {message}
  lowers to: emit procedure.report with message = {message}.

=== sections ===
section "Workflow — steps" -> procedure
section "Workflow — steps 2" -> procedure
section "Workflow — steps 3" -> procedure
section "Batch body — steps" -> procedure
section "Batch body — steps 2" -> procedure
section "DBA notes — steps" -> procedure
section "Procedure — steps" -> procedure
section "Procedure — steps 2" -> procedure
section "Procedure — steps 3" -> procedure
section "Transaction body — steps" -> procedure
section "Transaction body — steps 2" -> procedure
section "Assertions — steps" -> procedure
section "Dispatch table — steps" -> procedure

section "Procedure", "Transaction body", "Batch body" -> procedure
section "Invocation", "Use this when", "When this applies" -> applicability
section "Assertions", "Postconditions", "Constraints", "Controls", "Guarantees" -> invariants
section "Trace shape", "Report shape", "Output" -> template
