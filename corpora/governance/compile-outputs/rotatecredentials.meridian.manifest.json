  "meridian_skill" : {
    "description" : "Rotate any active credential that has aged past its 90-day freshness window, retrying the rotation call until the provider confirms the credential is fresh again. This is the mechanical half of credential hygiene — the half that doesn't need a human decision, just a loop that doesn't give up early.",
    "name" : "rotate credentials",
