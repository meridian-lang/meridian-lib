        "heading" : "Workflow — steps",
        "line" : 39,
        "lines" : [
          "fetch active patients",
          "Check: at least 1 patient",
          "Check: at most 50 patients",
          "let patient count be the number of patients",
          "let held count be the number of patients whose status is \"held\""
        ],
        "role" : "procedure"
      },
      {
